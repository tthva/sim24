generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  username                 String                 @unique
  password                 String
  fullName                 String?
  phone                    String?
  email                    String?
  active                   Boolean                @default(true)
  userType                 UserType
  tokenVersion             Int                    @default(0)
  lastLogin                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  adminProfile             Admin?
  agentProfile             Agent?
  auditLogs                AuditLog[]
  roleAssignments          UserRoleAssignment[]
  sessions                 Session[]
  refreshTokens            RefreshToken[]
  workflowStepAssignments  WorkflowStepInstance[] @relation("StepAssignee")
  attachments              Attachment[]
  workflowVersions         WorkflowVersion[]      @relation("VersionCreator")
  createdWorkflows         Workflow[]             @relation("WorkflowCreator")
  updatedWorkflows         Workflow[]             @relation("WorkflowUpdater")
  crmNotesAuthored         CustomerNote[]         @relation("CrmNoteAuthor")
  crmDocumentsUploaded     CustomerDocument[]     @relation("CrmDocUploader")
  communicationsAsOperator Communication[]        @relation("CommunicationOperator")
  templatesCreated         MessageTemplate[]      @relation("TemplateCreator")
  activitiesAsAssignee     Activity[]             @relation("ActivityAssignee")
  recurringTasksAsAssignee RecurringTask[]        @relation("RecurringTaskAssignee")
  opportunitiesAsAssignee  Opportunity[]          @relation("OpportunityAssignee")
  taskRejectionsAsRejector TaskRejection[]        @relation("TaskRejector")
  automationRulesCreated   AutomationRule[]       @relation("AutomationRuleCreator")

  @@index([userType])
  @@index([active])
  @@map("users")
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String?        @db.Uuid // Optional: null for EndUser sessions
  endUserId     String?        @db.Uuid // Optional: for EndUser authentication
  refreshFamily String         @unique
  userAgent     String?
  ipAddress     String?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  endUser       EndUser?       @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([endUserId])
  @@index([refreshFamily])
  @@map("sessions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid // Optional: null for EndUser refresh tokens
  endUserId  String?   @db.Uuid // Optional: for EndUser authentication
  sessionId  String    @db.Uuid
  tokenHash  String    @unique
  family     String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endUser    EndUser?  @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endUserId])
  @@index([family])
  @@map("refresh_tokens")
}

model Admin {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @db.Uuid
  department Department
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents     Agent[]

  @@index([department])
  @@map("admins")
}

model Agent {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  department           Department
  adminId              String?            @db.Uuid
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  admin                Admin?             @relation(fields: [adminId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  forms                CustomerForm[]
  notifications        Notification[]
  workflowInstances    WorkflowInstance[]
  crmReferredCustomers Customer[]         @relation("CustomerReferral")

  @@index([department])
  @@index([adminId])
  @@map("agents")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  title       String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  group           String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

model CustomerForm {
  id              String       @id @default(cuid())
  phone           String?
  fullName        String?
  nationalId      String?
  formType        String
  formData        Json
  metadata        Json?
  workflowCode    String?
  workflowStarted Boolean      @default(false)
  agentId         String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  agent           Agent?       @relation(fields: [agentId], references: [id])
  attachments     Attachment[]

  @@index([formType])
  @@index([phone])
  @@index([agentId])
  @@index([workflowCode])
  @@index([workflowStarted])
  @@index([formType, createdAt])
  @@index([formType, workflowStarted, createdAt])
  @@index([phone, formType, createdAt])
  @@index([fullName, formType])
  @@map("customer_forms")
}

model EndUser {
  id            String         @id @default(uuid()) @db.Uuid
  username      String         @unique
  password      String
  phone         String?
  fullName      String?
  active        Boolean        @default(true)
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  refreshTokens RefreshToken[]

  @@map("end_users")
}

model Workflow {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  title       String
  description String?
  department  Department
  status      WorkflowStatus    @default(DRAFT)
  createdById String            @db.Uuid
  updatedById String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    WorkflowVersion[]
  createdBy   User              @relation("WorkflowCreator", fields: [createdById], references: [id])
  updatedBy   User?             @relation("WorkflowUpdater", fields: [updatedById], references: [id])

  @@index([department])
  @@index([status])
  @@map("workflows")
}

model WorkflowVersion {
  id          String             @id @default(uuid()) @db.Uuid
  workflowId  String             @db.Uuid
  version     Int
  schema      Json
  changelog   String?
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now())
  instances   WorkflowInstance[]
  steps       WorkflowStep[]
  createdBy   User               @relation("VersionCreator", fields: [createdById], references: [id])
  workflow    Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

/// A single step in a workflow
model WorkflowStep {
  id             String                 @id @default(uuid()) @db.Uuid
  versionId      String                 @db.Uuid
  stepOrder      Int
  code           String
  title          String
  description    String?
  department     Department
  formSchema     Json
  allowedActions String[]
  isInitial      Boolean                @default(false)
  isFinal        Boolean                @default(false)
  slaHours       Int?
  rejectBehavior RejectBehavior         @default(END_WORKFLOW)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  instances      WorkflowStepInstance[]
  version        WorkflowVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, stepOrder])
  @@index([versionId])
  @@index([department])
  @@map("workflow_steps")
}

/// Runtime instance of a workflow
model WorkflowInstance {
  id               String                 @id @default(uuid()) @db.Uuid
  versionId        String                 @db.Uuid
  agentId          String?                @db.Uuid
  status           WorkflowInstanceStatus @default(PENDING)
  formData         Json
  metadata         Json?
  currentStepOrder Int?
  customerFormId   String?
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  agent            Agent?                 @relation(fields: [agentId], references: [id])
  version          WorkflowVersion        @relation(fields: [versionId], references: [id])
  stepInstances    WorkflowStepInstance[]

  @@index([versionId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@map("workflow_instances")
}

/// Runtime snapshot of a single step's execution
model WorkflowStepInstance {
  id           String           @id @default(uuid()) @db.Uuid
  instanceId   String           @db.Uuid
  stepId       String           @db.Uuid
  status       StepStatus       @default(PENDING)
  assignedToId String?          @db.Uuid
  data         Json?
  formData     Json?
  notes        String?
  dueAt        DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedTo   User?            @relation("StepAssignee", fields: [assignedToId], references: [id])
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step         WorkflowStep     @relation(fields: [stepId], references: [id])

  @@index([instanceId])
  @@index([stepId])
  @@index([assignedToId])
  @@index([status])
  @@map("workflow_step_instances")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @db.Uuid
  entity     String
  entityId   String?
  action     AuditAction
  department Department?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([department])
  @@map("audit_logs")
}

model WebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  payload   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, read])
  @@map("notifications")
}

model Attachment {
  id           String        @id @default(uuid()) @db.Uuid
  fileKey      String        @unique
  originalName String
  mimeType     String
  fileSize     Int
  formId       String?
  uploadedById String        @db.Uuid
  createdAt    DateTime      @default(now())
  form         CustomerForm? @relation(fields: [formId], references: [id])
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])

  @@index([formId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("attachments")
}

enum Department {
  PRICE
  INVESTMENT
  PRODUCT
  SELL
}

enum UserType {
  ADMIN
  AGENT
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum StepStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  COMPLETE
  REJECT
  TRANSFER
  REASSIGN
  STEP_ASSIGNED
  STEP_COMPLETED
  STEP_REJECTED
  STEP_REASSIGNED
}

enum RejectBehavior {
  END_WORKFLOW
  GO_TO_STEP
}

model ConsignmentItem {
  id                 String    @id @default(cuid())
  simNumber          String
  ownerName          String
  phone              String
  price              String?
  status             String    @default("available") // available, reserved, sold
  notes              String?
  duration           Int? // مدت امانت (روز)
  source             String    @default("manual") // manual | workflow
  workflowInstanceId String?   @unique // SELL_CONSIGNMENT instance that created this item (per-instance dedupe)
  deletedAt          DateTime? // soft delete — null = active
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("consignment_items")
}

// ─── Price-expert anti-abuse lists ───
model BlacklistPhone {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  addedById String?  @db.Uuid // operator user who added
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("blacklist_phones")
}

model WhitelistPhone {
  id        String   @id @default(cuid())
  phone     String   @unique
  note      String?
  addedById String?  @db.Uuid // operator user who added
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("whitelist_phones")
}

// ─────────────────────────────────────────────
// CRM — Phase 1: Customer 360
// ─────────────────────────────────────────────

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  customerCode       String    @unique // "C-" + 6-digit sequential (crm customer-code generator)
  fullName           String?
  primaryPhone       String    @unique
  secondaryPhone     String?
  nationalId         String?
  segment            String    @default("regular") // vip | hot | regular | cold
  status             String    @default("active") // active | inactive
  score              Int       @default(0) // engagement score (0-100)
  source             String? // form source: buy_direct | sell_direct | search | invest_* | manual
  referralAgentId    String?   @db.Uuid
  firstInteractionAt DateTime?
  lastInteractionAt  DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  interactions   CustomerInteraction[]
  notes          CustomerNote[]
  tags           CustomerTag[]
  documents      CustomerDocument[]
  communications Communication[]
  activities     Activity[]
  opportunities  Opportunity[]
  referralAgent  Agent?                @relation("CustomerReferral", fields: [referralAgentId], references: [id])

  @@index([customerCode])
  @@index([primaryPhone])
  @@index([segment])
  @@index([status])
  @@index([score])
  @@index([lastInteractionAt])
  @@index([createdAt])
  @@map("crm_customers")
}

model CustomerInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  interactionType String // form_submission | call | note | meeting | sms | email
  referenceId     String? // e.g. CustomerForm.id
  title           String
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([interactionType])
  @@index([referenceId])
  @@map("crm_customer_interactions")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  content    String
  authorId   String?  @db.Uuid
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author     User?    @relation("CrmNoteAuthor", fields: [authorId], references: [id])

  @@index([customerId, createdAt])
  @@map("crm_customer_notes")
}

model CustomerTag {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  tag        String
  color      String? // hex color for UI badge
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
  @@index([tag])
  @@map("crm_customer_tags")
}

model CustomerDocument {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  fileKey      String   @unique
  title        String?
  mimeType     String?
  fileSize     Int?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("CrmDocUploader", fields: [uploadedById], references: [id])

  @@index([customerId, createdAt])
  @@map("crm_customer_documents")
}

model Communication {
  id         String  @id @default(cuid())
  customerId String  @db.Uuid
  channel    String // "sms" | "call" | "note" | "chat"
  direction  String // "inbound" | "outbound"
  subject    String?
  content    String  @db.Text
  status     String  @default("pending") // pending | sent | delivered | failed | read

  // Call-specific
  durationSec  Int?
  recordingUrl String?

  // SMS/Email-specific
  externalId String?
  templateId String?

  operatorId    String  @db.Uuid
  relatedTaskId String? @db.Uuid

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  operator User     @relation("CommunicationOperator", fields: [operatorId], references: [id])

  @@index([customerId, createdAt])
  @@index([channel])
  @@index([status])
  @@index([operatorId, createdAt])
  @@map("crm_communications")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String
  channel     String // "sms" | "email"
  subject     String?
  content     String   @db.Text
  variables   String[]
  category    String? // welcome | followup | rejection | payment | custom
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("TemplateCreator", fields: [createdById], references: [id])

  @@index([channel])
  @@index([category])
  @@index([isActive])
  @@map("crm_message_templates")
}

model Activity {
  id           String    @id @default(cuid())
  customerId   String?   @db.Uuid
  type         String // "call" | "meeting" | "note" | "followup"
  title        String
  description  String?   @db.Text
  dueAt        DateTime?
  completedAt  DateTime?
  assignedToId String    @db.Uuid
  priority     String    @default("normal") // low | normal | high | urgent
  status       String    @default("pending") // pending | completed | cancelled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User      @relation("ActivityAssignee", fields: [assignedToId], references: [id])

  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([customerId])
  @@map("crm_activities")
}

model RecurringTask {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  cronExpr     String
  assignedToId String    @db.Uuid
  priority     String    @default("normal")
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo User @relation("RecurringTaskAssignee", fields: [assignedToId], references: [id])

  @@index([isActive, nextRunAt])
  @@index([assignedToId])
  @@map("crm_recurring_tasks")
}

model Pipeline {
  id         String   @id @default(cuid())
  name       String
  department String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([isDefault])
  @@index([department])
  @@map("crm_pipelines")
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  code       String
  name       String
  order      Int
  color      String?
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, code])
  @@index([pipelineId, order])
  @@map("crm_pipeline_stages")
}

model Opportunity {
  id              String    @id @default(cuid())
  customerId      String    @db.Uuid
  pipelineId      String
  stageId         String
  title           String
  description     String?   @db.Text
  estimatedValue  Decimal?  @db.Decimal(15, 0)
  probability     Int?
  expectedCloseAt DateTime?
  assignedToId    String?   @db.Uuid

  workflowInstanceId String?
  customerFormId     String?

  rejectionReasonId String?
  rejectionNotes    String?  @db.Text
  rejectionFiles    String[]

  wonAt     DateTime?
  lostAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pipeline        Pipeline         @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage    @relation(fields: [stageId], references: [id])
  assignedTo      User?            @relation("OpportunityAssignee", fields: [assignedToId], references: [id])
  rejectionReason RejectionReason? @relation(fields: [rejectionReasonId], references: [id])

  @@index([customerId])
  @@index([stageId])
  @@index([assignedToId])
  @@index([pipelineId, stageId])
  @@index([createdAt])
  @@map("crm_opportunities")
}

model RejectionReason {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String?
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  opportunities  Opportunity[]
  taskRejections TaskRejection[]

  @@index([isActive])
  @@index([category])
  @@map("crm_rejection_reasons")
}

model TaskRejection {
  id             String   @id @default(cuid())
  stepInstanceId String
  reasonId       String
  notes          String?  @db.Text
  attachments    String[]
  rejectedById   String   @db.Uuid
  rejectedAt     DateTime @default(now())

  reason     RejectionReason @relation(fields: [reasonId], references: [id])
  rejectedBy User            @relation("TaskRejector", fields: [rejectedById], references: [id])

  @@index([stepInstanceId])
  @@index([reasonId])
  @@index([rejectedAt])
  @@map("crm_task_rejections")
}

model AutomationRule {
  id            String    @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean   @default(true)
  priority      Int       @default(0)
  trigger       String
  triggerConfig Json?
  conditions    Json
  actions       Json
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy User            @relation("AutomationRuleCreator", fields: [createdById], references: [id])
  logs      AutomationLog[]

  @@index([isActive, priority])
  @@index([trigger])
  @@map("automation_rules")
}

model AutomationLog {
  id          String   @id @default(cuid())
  ruleId      String
  triggeredBy String
  entityType  String?
  entityId    String?
  success     Boolean
  error       String?  @db.Text
  context     Json?
  durationMs  Int?
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([success])
  @@index([entityType, entityId])
  @@map("automation_logs")
}

model DailyMetric {
  id                 String   @id @default(cuid())
  date               DateTime @unique @db.Date
  customersNew       Int      @default(0)
  customersActive    Int      @default(0)
  formsSubmitted     Int      @default(0)
  formsByType        Json?
  tasksAssigned      Int      @default(0)
  tasksCompleted     Int      @default(0)
  tasksRejected      Int      @default(0)
  avgTaskDurationMin Int?
  dealsCreated       Int      @default(0)
  dealsWon           Int      @default(0)
  dealsLost          Int      @default(0)
  dealValue          Decimal  @default(0) @db.Decimal(15, 0)
  smsSent            Int      @default(0)
  smsReceived        Int      @default(0)
  callsMade          Int      @default(0)
  revenue            Decimal  @default(0) @db.Decimal(15, 0)
  conversionRate     Float?
  createdAt          DateTime @default(now())

  @@index([date])
  @@map("daily_metrics")
}
