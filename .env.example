# ============================
# SIM24 — Environment Variables
# ============================

# --- Database ---
DATABASE_URL=postgresql://sim24:your_strong_password@postgres:5432/sim24

POSTGRES_USER=sim24
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=sim24

# --- PostgreSQL HDD Optimization ---
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_RANDOM_PAGE_COST=4.0
POSTGRES_SEQ_PAGE_COST=2.0

# --- Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_hex_chars_secret

# --- Runtime ---
NODE_ENV=production

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- BullMQ Queue ---
QUEUE_REDIS_URL=redis://redis:6379
QUEUE_CONCURRENCY=5

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ROOT_USER=sim24admin
MINIO_ROOT_PASSWORD=your_minio_secret_key_change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sim24-uploads
MINIO_CONSOLE_PORT=9001

# --- Webhook (optional) ---
CRM_WEBHOOK_URL=
CRON_API_KEY=

# --- Backup ---
BACKUP_RETENTION_DAYS=14
# Remote backup target (optional, S3-compatible)
REMOTE_BACKUP_ENDPOINT=
REMOTE_BACKUP_BUCKET=
REMOTE_BACKUP_ACCESS_KEY=
REMOTE_BACKUP_SECRET_KEY=

# --- Docker Compose Only ---
NGINX_PORT=80
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMTAIL_PORT=9080
LOKI_PORT=3100

# --- Grafana Loki ---
LOKI_RETENTION_PERIOD=168h
LOKI_MAX_LOOK_BACK_PERIOD=168h

# --- Resource Limits (16GB Server) ---
APP_MEM_LIMIT=768M
APP_CPU_LIMIT=1.0
POSTGRES_MEM_LIMIT=1G
POSTGRES_CPU_LIMIT=2.0
REDIS_MEM_LIMIT=256M
NGINX_MEM_LIMIT=128M
MINIO_MEM_LIMIT=512M
PROMETHEUS_MEM_LIMIT=512M
GRAFANA_MEM_LIMIT=256M
LOKI_MEM_LIMIT=512M
WORKER_MEM_LIMIT=512M